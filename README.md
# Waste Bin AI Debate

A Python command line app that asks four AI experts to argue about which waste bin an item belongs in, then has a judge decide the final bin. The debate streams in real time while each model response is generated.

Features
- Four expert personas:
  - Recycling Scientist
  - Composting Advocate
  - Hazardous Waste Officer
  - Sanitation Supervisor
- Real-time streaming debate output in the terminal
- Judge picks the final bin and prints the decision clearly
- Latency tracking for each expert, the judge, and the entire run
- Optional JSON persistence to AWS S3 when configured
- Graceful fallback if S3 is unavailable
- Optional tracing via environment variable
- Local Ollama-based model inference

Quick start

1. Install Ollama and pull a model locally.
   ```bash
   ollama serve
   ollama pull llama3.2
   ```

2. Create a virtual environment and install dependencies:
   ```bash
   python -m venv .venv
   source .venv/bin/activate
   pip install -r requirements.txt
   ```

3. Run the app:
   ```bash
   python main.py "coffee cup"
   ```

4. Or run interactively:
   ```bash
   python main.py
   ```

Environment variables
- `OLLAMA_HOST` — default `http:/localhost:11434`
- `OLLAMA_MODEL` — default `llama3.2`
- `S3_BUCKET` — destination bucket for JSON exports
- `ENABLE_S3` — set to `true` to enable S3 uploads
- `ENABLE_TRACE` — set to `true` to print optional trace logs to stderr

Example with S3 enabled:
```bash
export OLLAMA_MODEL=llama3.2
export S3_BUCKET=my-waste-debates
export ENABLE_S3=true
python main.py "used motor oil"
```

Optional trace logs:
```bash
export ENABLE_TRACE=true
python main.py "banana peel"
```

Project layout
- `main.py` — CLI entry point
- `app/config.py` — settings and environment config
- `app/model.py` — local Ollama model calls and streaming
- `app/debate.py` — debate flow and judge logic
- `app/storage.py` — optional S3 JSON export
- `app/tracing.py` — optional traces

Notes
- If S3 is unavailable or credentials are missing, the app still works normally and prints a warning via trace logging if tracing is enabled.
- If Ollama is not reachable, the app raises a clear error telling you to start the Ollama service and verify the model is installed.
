import argparse
import os
import sys
import time
import uuid
from typing import Any

from app.config import load_config
from app.debate import DebateEngine
from app.storage import S3JSONStore, build_run_summary
from app.tracing import log_trace


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Debate which waste bin an item belongs in using local Ollama models.")
    parser.add_argument("item", nargs="?", help="Item to sort (for example: 'battery', 'coffee cup', 'banana peel')")
    parser.add_argument("--item", dest="item_flag", help="Item to sort as a flag instead of positional argument.")
    parser.add_argument("--model", default=None, help="Ollama model name to use (default: OLLAMA_MODEL or llama3.2).")
    parser.add_argument("--s3-bucket", default=None, help="AWS S3 bucket for JSON outputs. If omitted, uses S3_BUCKET env var.")
    parser.add_argument("--disable-s3", action="store_true", help="Disable S3 uploads even if S3_BUCKET is configured.")
    parser.add_argument("--trace", action="store_true", help="Enable optional trace logging to stderr.")
    return parser.parse_args()


def resolve_item(args: argparse.Namespace) -> str:
    items = [args.item, args.item_flag]
    for value in items:
        if value and value.strip():
            return value.strip()
    return input("Enter the item to sort: ").strip()


def print_latency_summary(run: Any, run_id: str, item: str) -> None:
    print("\n=== Latency Summary ===")
    print(f"Run ID: {run_id}")
    print(f"Item: {item}")

    if getattr(run, "experts", None):
        for turn in run.experts:
            print(f"- {turn.expert} ({turn.bin}): {turn.duration_seconds:.3f}s")
    if getattr(run, "judge", None):
        print(f"- Judge: {run.judge.duration_seconds:.3f}s")
    print(f"- Total run: {run.run_duration_seconds:.3f}s")


def main() -> None:
    args = parse_args()
    config = load_config()

    if args.model:
        os.environ["OLLAMA_MODEL"] = args.model
        config = load_config()
    if args.s3_bucket:
        os.environ["S3_BUCKET"] = args.s3_bucket
        config = load_config()
    if args.trace:
        os.environ["ENABLE_TRACE"] = "true"
        config = load_config()
    if args.disable_s3:
        os.environ["ENABLE_S3"] = "false"
        config = load_config()

    run_id = str(uuid.uuid4())
    item = resolve_item(args)
    print(f"\nSorting item: {item}")
    print(f"Using Ollama model: {config.model_name}")

    if not os.environ.get("OLLAMA_HOST"):
        os.environ["OLLAMA_HOST"] = config.ollama_host

    store = S3JSONStore(config)
    engine = DebateEngine(config)
    start_time = time.perf_counter()
    try:
        debate_run = engine.run(item)
    except Exception as exc:
        print(f"\n[ERROR] Failed to complete debate: {exc}")
        raise SystemExit(1) from exc

    elapsed = time.perf_counter() - start_time
    debate_run.run_duration_seconds = round(elapsed, 3)

    if hasattr(debate_run, "judge") and debate_run.judge:
        print(f"\nFinal decision: {debate_run.judge.final_bin}")

    summary = build_run_summary(run_id, item, {
        "item": item,
        "experts": [
            {"expert": turn.expert, "bin": turn.bin, "response": turn.response.strip(), "duration_seconds": turn.duration_seconds}
            for turn in debate_run.experts
        ],
        "judge": {
            "final_bin": debate_run.judge.final_bin if debate_run.judge else None,
            "reasoning": debate_run.judge.reasoning if debate_run.judge else None,
            "duration_seconds": debate_run.judge.duration_seconds if debate_run.judge else None,
        },
        "run_duration_seconds": debate_run.run_duration_seconds,
    })

    store.save_debate(run_id, item, summary)
    store.save_run_summary(run_id, summary)

    print_latency_summary(debate_run, run_id, item)
    log_trace("Run complete", run_id=run_id, item=item, total_seconds=debate_run.run_duration_seconds)


if __name__ == "__main__":
    main()
